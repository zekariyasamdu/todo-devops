# environment variables (secrets, DB URLs, etc — never commit these)
.env
.env.local
.env.*.local
# Core node files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# Yarn Modern specific rules (With Zero-Installs)
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Ensure you do NOT ignore the lockfile
!yarn.lock
